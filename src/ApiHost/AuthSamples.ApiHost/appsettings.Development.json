{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuthDatabase": "Server=localhost,11433;Database=AuthSamplesDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "BackgroundJobsDatabase": "Server=localhost,11433;Database=BackgroundJobsDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "CognitoSettings": {
    "UserPoolId": "us-east-1_XXXXXXXXX",
    "ClientId": "XXXXXXXXXXXXXXXXXXXXXXXXXX",
    "ClientSecret": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "Region": "us-east-1"
  },
  "CognitoOidcSettings": {
    "Domain": "your-app.auth.us-east-1.amazoncognito.com",
    "ClientId": "XXXXXXXXXXXXXXXXXXXXXXXXXX",
    "ClientSecret": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "CallbackUrl": "http://localhost:5000/api/v1/auth/oauth/callback",
    "LogoutCallbackUrl": "http://localhost:5000/api/v1/auth/oauth/logout-callback",
    "FrontendCallbackUrl": "http://localhost:3000",
    "Scopes": ["openid", "email", "profile"],
    "StateCacheDurationSeconds": 300
  },
  "BackgroundJobs": {
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 2
  },
  "Notifications": {
    "SendGrid": {
      "ApiKey": "",
      "DefaultFromEmail": "noreply@example.com",
      "DefaultFromName": "AuthSamples (Dev)"
    }
  }
}

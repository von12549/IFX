{
  "Runtime": {
    "Role": "all",
    "Capabilities": {
      "Api": true,
      "HangfireClient": true,
      "HangfireServer": true,
      "Dispatcher": false,
      "Consumers": false,
      "RecurringScheduler": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "BackgroundJobs": {
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 2
  },
  "Opa": {
    "Enabled": false,
    "FailClosed": false
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpContextBoundary": {
    "AllowTrustedGatewayCorrelationPropagation": false,
    "TrustedGatewayAddresses": []
  },
  "Runtime": {
    "Role": "api",
    "AllowAllInProduction": false,
    "DependencyPollSeconds": 10,
    "DependencyTimeoutSeconds": 5,
    "Drain": {
      "OperationBudget": "00:00:10",
      "HandlerBudget": "00:00:20",
      "LeaseBudget": "00:00:30",
      "ProcessGrace": "00:00:40",
      "OrchestratorKill": "00:00:45",
      "TelemetryFlushReserve": "00:00:02"
    },
    "Capabilities": {
      "Api": true,
      "HangfireClient": true,
      "HangfireServer": false,
      "Dispatcher": false,
      "Consumers": false,
      "RecurringScheduler": false
    }
  },
  "Messaging": {
    "Health": {
      "WarningAge": "00:02:00",
      "CriticalAge": "00:10:00",
      "WarningCount": 500,
      "CriticalCount": 5000,
      "WarningDeadLetters": 1,
      "CriticalDeadLetters": 10,
      "CriticalStorageUtilization": 0.85,
      "RetryAfter": "00:00:30"
    },
    "Replay": {
      "SupportedHandlers": {
        "ifx.transaction.transaction-processed.v1": "holdings-1",
        "ifx.registry.class-status-changed.v1": "holdings-1"
      }
    }
  },
  "ConnectionStrings": {
    "AuthDatabase": "",
    "CrmDatabase": "",
    "RegistryDatabase": "",
    "HoldingsDatabase": "",
    "TransactionDatabase": "",
    "BackgroundJobsDatabase": ""
  },
  "CognitoSettings": {
    "UserPoolId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Region": ""
  },
  "CognitoOidcSettings": {
    "Domain": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackUrl": "",
    "LogoutCallbackUrl": "",
    "FrontendCallbackUrl": "",
    "Scopes": ["openid", "email", "profile"],
    "StateCacheDurationSeconds": 300
  },
  "BackgroundJobs": {
    "ConnectionString": "",
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4,
    "ServerName": "",
    "Queues": ["default", "email", "report"]
  },
  "Notifications": {
    "SendGrid": {
      "ApiKey": "",
      "DefaultFromEmail": "",
      "DefaultFromName": "",
      "SandboxMode": false
    }
  },
  "EmailVerification": {
    "TokenValidityMinutes": 60,
    "MaxResendsPerHour": 3,
    "VerificationBaseUrl": "http://localhost:5010/api/v1/auth/email/verify"
  },
  "Opa": {
    "BaseUrl": "http://localhost:8181",
    "TimeoutSeconds": 5,
    "FailClosed": true,
    "Enabled": true
  }
}

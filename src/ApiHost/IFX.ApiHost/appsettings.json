{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "Role": "api",
    "AllowAllInProduction": false,
    "DependencyPollSeconds": 10,
    "DependencyTimeoutSeconds": 5,
    "Capabilities": {
      "Api": true,
      "HangfireClient": true,
      "HangfireServer": false,
      "Dispatcher": false,
      "Consumers": false,
      "RecurringScheduler": false
    }
  },
  "ConnectionStrings": {
    "AuthDatabase": "",
    "CrmDatabase": "",
    "RegistryDatabase": "",
    "HoldingsDatabase": "",
    "TransactionDatabase": "",
    "BackgroundJobsDatabase": ""
  },
  "CognitoSettings": {
    "UserPoolId": "",
    "ClientId": "",
    "ClientSecret": "",
    "Region": ""
  },
  "CognitoOidcSettings": {
    "Domain": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackUrl": "",
    "LogoutCallbackUrl": "",
    "FrontendCallbackUrl": "",
    "Scopes": ["openid", "email", "profile"],
    "StateCacheDurationSeconds": 300
  },
  "BackgroundJobs": {
    "ConnectionString": "",
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "WorkerCount": 4,
    "ServerName": "",
    "Queues": ["default", "email", "report"]
  },
  "Notifications": {
    "SendGrid": {
      "ApiKey": "",
      "DefaultFromEmail": "",
      "DefaultFromName": "",
      "SandboxMode": false
    }
  },
  "EmailVerification": {
    "TokenValidityMinutes": 60,
    "MaxResendsPerHour": 3,
    "VerificationBaseUrl": "http://localhost:5010/api/v1/auth/email/verify"
  },
  "Opa": {
    "BaseUrl": "http://localhost:8181",
    "TimeoutSeconds": 5,
    "FailClosed": true,
    "Enabled": true
  }
}

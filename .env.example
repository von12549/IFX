# AWS Cognito Configuration
# Copy this file to .env and replace the placeholder values with your actual AWS Cognito settings

COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-2

# Cognito OAuth/OIDC Configuration (Managed Login)
# Configure these after setting up Cognito User Pool domain
COGNITO_OIDC_DOMAIN=your-app.auth.ap-southeast-2.amazoncognito.com
COGNITO_OIDC_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/callback
COGNITO_OIDC_LOGOUT_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/logout-callback

# Notes:
# - You can find these values in the AWS Cognito Console
# - See docs/AWS_COGNITO_SETUP.md for detailed setup instructions
# - See docs/Plans/cognito-managed-login.md for OAuth setup
# - Never commit the actual .env file to version control

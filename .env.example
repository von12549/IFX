# AWS Cognito Configuration
# Copy this file to .env and replace the placeholder values with your actual AWS Cognito settings

COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_REGION=us-east-1

# Notes:
# - You can find these values in the AWS Cognito Console
# - See docs/AWS_COGNITO_SETUP.md for detailed setup instructions
# - Never commit the actual .env file to version control

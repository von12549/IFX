# IFX Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control

# =============================================================================
# DATABASE
# =============================================================================
DB_SERVER=localhost,11433
DB_USER=sa
DB_PASSWORD=YourStrong@Pass123

# =============================================================================
# IDENTITY PROVIDER
# =============================================================================
# Selects which identity provider implementation is active.
# Valid values: Cognito, Auth0
AUTHENTICATION_PROVIDER=Cognito

# =============================================================================
# AWS COGNITO
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-2

COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=ap-southeast-2

# Cognito OIDC / Managed Login
COGNITO_OIDC_DOMAIN=your-app.auth.ap-southeast-2.amazoncognito.com
COGNITO_OIDC_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/callback
COGNITO_OIDC_LOGOUT_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/logout-callback
COGNITO_OIDC_FRONTEND_CALLBACK_URL=http://localhost:3000

# =============================================================================
# AUTH0 (set AUTHENTICATION_PROVIDER=Auth0 to use)
# =============================================================================
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
# AUTH0_AUDIENCE=https://your-api-identifier
# AUTH0_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/callback
# AUTH0_LOGOUT_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/logout-callback

# =============================================================================
# BACKGROUND JOBS (Hangfire)
# =============================================================================
# Uses BackgroundJobsDb database by default
# Override with full connection string if needed
# HANGFIRE_CONNECTION_STRING=
HANGFIRE_WORKER_COUNT=4
HANGFIRE_SERVER_NAME=auth-api-worker
HANGFIRE_QUEUE_0=default
HANGFIRE_QUEUE_1=email
HANGFIRE_QUEUE_2=report

# =============================================================================
# NOTIFICATIONS (SendGrid)
# =============================================================================
# Leave SENDGRID_API_KEY empty to use NoOp email service (logs but doesn't send)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=IFX

# =============================================================================
# EMAIL VERIFICATION
# =============================================================================
EMAIL_VERIFICATION_TOKEN_VALIDITY=60
EMAIL_VERIFICATION_MAX_RESENDS=3
EMAIL_VERIFICATION_BASE_URL=http://localhost:5000/api/v1/auth/email/verify

# =============================================================================
# OPA (Open Policy Agent) — ABAC Authorization
# =============================================================================
# OPA runs as a sidecar in docker-compose. Override these if using an external OPA instance.
# OPA_BASE_URL=http://localhost:8181
# OPA_ENABLED=true
# OPA_FAIL_CLOSED=true
# Set OPA_ENABLED=false to bypass OPA entirely (uses NullOpaPolicyClient — always allow).
# WARNING: only use OPA_ENABLED=false in local development. Never in production.

# =============================================================================
# Notes:
# - You can find Cognito values in the AWS Cognito Console
# - See docs/AWS_COGNITO_SETUP.md for detailed setup instructions
# - See .claude/Plans/cognito-managed-login.md for OAuth setup
# - See policies/README.md for OPA policy testing and local setup
# - Never commit the actual .env file to version control
# =============================================================================

# IFX NAS Environment Configuration
# Copy this file to .env on your NAS and fill in your values
# Place this file alongside docker-compose.nas.yml on the NAS

# =============================================================================
# NAS
# =============================================================================
# Set this to your NAS local IP (e.g. 192.168.1.100)
NAS_IP=192.168.1.100

# Docker image names (as pushed to Docker Hub or GHCR)
IFX_API_IMAGE=your-dockerhub-username/ifx-api:latest
IFX_DATABASE_MIGRATOR_IMAGE=your-dockerhub-username/ifx-database-migrator:latest
IFX_FRONTEND_IMAGE=your-dockerhub-username/ifx-frontend:latest

# =============================================================================
# DATABASE
# =============================================================================
DB_PASSWORD=YourStrong@Pass123
# Use distinct secret records in non-local environments. The defaults may intentionally point to
# the same local account, but runtime identity must not receive DDL permissions in production.
MIGRATION_DB_USER=sa
MIGRATION_DB_PASSWORD=YourStrong@Pass123
RUNTIME_DB_USER=sa
RUNTIME_DB_PASSWORD=YourStrong@Pass123

# =============================================================================
# IDENTITY PROVIDER
# =============================================================================
AUTHENTICATION_PROVIDER=Cognito

# =============================================================================
# AWS COGNITO
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-southeast-2

COGNITO_USER_POOL_ID=your-region_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_REGION=ap-southeast-2

COGNITO_OIDC_DOMAIN=your-app.auth.ap-southeast-2.amazoncognito.com
# These are auto-built from NAS_IP in docker-compose.nas.yml — only set these
# if you want to override (e.g. using a domain name instead of IP)
# COGNITO_OIDC_CALLBACK_URL=http://192.168.1.100:5010/api/v1/auth/oauth/callback
# COGNITO_OIDC_LOGOUT_CALLBACK_URL=http://192.168.1.100:5010/api/v1/auth/oauth/logout-callback
# COGNITO_OIDC_FRONTEND_CALLBACK_URL=http://192.168.1.100:8030/callback

# =============================================================================
# BACKGROUND JOBS (Hangfire)
# =============================================================================
HANGFIRE_WORKER_COUNT=4
HANGFIRE_SERVER_NAME=auth-api-worker
HANGFIRE_QUEUE_0=default
HANGFIRE_QUEUE_1=email
HANGFIRE_QUEUE_2=report

# =============================================================================
# NOTIFICATIONS (SendGrid)
# =============================================================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=IFX

# =============================================================================
# EMAIL VERIFICATION
# =============================================================================
EMAIL_VERIFICATION_TOKEN_VALIDITY=60
EMAIL_VERIFICATION_MAX_RESENDS=3
# Auto-built from NAS_IP — override only if needed
# EMAIL_VERIFICATION_BASE_URL=http://192.168.1.100:5010/api/v1/auth/email/verify

# =============================================================================
# OPA
# =============================================================================
OPA_BASE_URL=http://opa:8181
OPA_TIMEOUT_SECONDS=5
OPA_ENABLED=true
OPA_FAIL_CLOSED=true

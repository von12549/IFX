{
  "permissions": {
    "allow": [
      "Bash(dir:*)",
      "Bash(rename Cognito Auth)",
      "Bash(git add:*)",
      "Bash(find:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet sln add:*)",
      "Bash(dotnet add:*)",
      "Bash(grep:*)",
      "Bash(for f:*)",
      "Bash(do echo:*)",
      "Read(//d/IFX/.claude/worktrees/agent-abd33152/**)",
      "Bash(done)",
      "Bash(DOMAIN=/d/IFX/src/Modules/Auth/IFX.Modules.Auth.Domain\nmkdir -p \"$DOMAIN/Users/Events\"\nmkdir -p \"$DOMAIN/Identity/Events\"\nmkdir -p \"$DOMAIN/Authorization\")",
      "Bash(cd:*)",
      "Bash(do)",
      "Bash(echo \"=== $f ===\")",
      "Read(//d/tmp/**)",
      "Read(//tmp/**)",
      "Bash(sqlcmd:*)",
      "WebFetch(domain:docs.frankieone.com)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:help.frankieone.com)"
    ]
  },
  "env": {

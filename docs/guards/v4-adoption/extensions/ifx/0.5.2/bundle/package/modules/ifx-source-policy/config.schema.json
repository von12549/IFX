{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-source-policy/config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["enabledClaims", "policySha256"],
  "properties": {
    "enabledClaims": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "enum": [
      "IFX.C1.IMPORT_DIRECTION_SOURCE", "IFX.C1.IMPORT_OWNERSHIP_SOURCE", "IFX.C1.IMPORT_PACKAGE_SOURCE",
      "IFX.C1.DECLARATION_NAMESPACE_SOURCE", "IFX.C1.DECLARATION_FORBIDDEN_SOURCE",
      "IFX.C1.DECLARATION_PLACEMENT_SOURCE", "IFX.C1.DECLARATION_IMPLEMENTS_SOURCE",
      "IFX.C1.SYMBOL_FORBIDDEN_SOURCE", "IFX.C1.PAYLOAD_TYPE_SOURCE"
    ] } },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-embedded-adapter/result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "findings", "coverage"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail", "error"] },
    "exitCategory": { "enum": ["success", "findings-blocking", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing"] },
    "message": { "type": "string" },
    "findings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["ruleId", "subject", "evidenceKind", "detectorId", "severity"], "properties": {
      "ruleId": { "enum": ["EMBEDDED-ADAPTER-LOCATION", "EMBEDDED-ADAPTER-PROVIDER"] },
      "subject": { "type": "string", "minLength": 1 },
      "evidenceKind": { "enum": ["source-syntax", "coverage"] },
      "detectorId": { "const": "ifx-embedded-adapter" },
      "severity": { "const": "blocking" }
    } } },
    "coverage": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["claimId", "matched", "minimum"], "properties": {
      "claimId": { "enum": ["IFX.C1.EMBEDDED_ADAPTER_LOCATION_SOURCE", "IFX.C1.EMBEDDED_ADAPTER_PROVIDER_SOURCE"] },
      "matched": { "type": "integer", "minimum": 0 }, "minimum": { "const": 1 }
    } } }
  }
}

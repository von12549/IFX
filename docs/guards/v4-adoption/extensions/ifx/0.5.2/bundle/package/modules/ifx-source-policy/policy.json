  "scanRoot": "src",
  "rings": {
    "Domain": ["IFX.Modules.*.Domain"],
    "Contracts": ["IFX.Modules.*.Contracts", "IFX.Platform.*.Contracts"],
    "Application": ["IFX.Modules.*.Application"],
    "Presentation": ["IFX.Modules.*.Presentation"],
    "IntegrationAdapter": ["IFX.Modules.*.Integration", "IFX.Modules.*.Infrastructure.Integrations"],
    "Infrastructure": ["IFX.Modules.*.Infrastructure", "IFX.Platform.*.Infrastructure.*"],
    "Client": ["IFX.Modules.*.Client"],
    "Runtime": ["IFX.Platform.*.Runtime"],
    "Composition": ["IFX.Modules.*.Composition", "IFX.Platform.*.Composition"],
    "RuntimeHost": ["IFX.ApiHost", "IFX.*.Worker"]
  },
  "ownership": { "modulePatterns": ["IFX.Modules.{module}.*", "IFX.Platform.{module}.*"], "requireKnown": true },
  "allowedDependencies": {
    "Domain": [], "Contracts": [], "Application": ["Domain", "Contracts"],
    "Presentation": ["Application", "Contracts", "Domain"],
    "IntegrationAdapter": ["Application", "Contracts"],
    "Infrastructure": ["Application", "Domain", "Contracts", "Client", "Runtime"],
    "Client": ["Contracts", "Runtime"], "Runtime": ["Contracts"],
    "Composition": ["Domain", "Contracts", "Application", "Presentation", "IntegrationAdapter", "Infrastructure", "Client", "Runtime"],
    "RuntimeHost": ["Composition"]
  },
  "referenceScopes": [
    { "from": "Domain", "to": "Domain", "ownership": "own" },
    { "from": "Contracts", "to": "Contracts", "ownership": "own" },
    { "from": "Application", "to": "Application", "ownership": "own" },
    { "from": "Application", "to": "Domain", "ownership": "own" },
    { "from": "Application", "to": "Contracts", "ownership": "none" },
    { "from": "Presentation", "to": "Application", "ownership": "own" },
    { "from": "Presentation", "to": "Contracts", "ownership": "own" },
    { "from": "Presentation", "to": "Domain", "ownership": "own" },
    { "from": "IntegrationAdapter", "to": "Application", "ownership": "own" },
    { "from": "IntegrationAdapter", "to": "Contracts", "ownership": "foreign" },
    { "from": "Infrastructure", "to": "Application", "ownership": "own" },
    { "from": "Infrastructure", "to": "Domain", "ownership": "own" },
    { "from": "Infrastructure", "to": "Contracts", "ownership": "any" },
    { "from": "Infrastructure", "to": "Client", "ownership": "any" },
    { "from": "Infrastructure", "to": "Runtime", "ownership": "any" },
    { "from": "Client", "to": "Contracts", "ownership": "own" },
    { "from": "Client", "to": "Runtime", "ownership": "any" },
    { "from": "Runtime", "to": "Contracts", "ownership": "any" },
    { "from": "Composition", "to": "Domain", "ownership": "own" },
    { "from": "Composition", "to": "Application", "ownership": "own" },
    { "from": "Composition", "to": "Presentation", "ownership": "own" },
    { "from": "Composition", "to": "Infrastructure", "ownership": "own" },
    { "from": "Composition", "to": "Client", "ownership": "any" },
    { "from": "Composition", "to": "Runtime", "ownership": "any" },
    { "from": "RuntimeHost", "to": "Composition", "ownership": "any" }
  ],
  "allowedPackages": {
    "Domain": [], "Contracts": [],
    "Application": ["MediatR*", "FluentValidation*", "AutoMapper*", "Microsoft.Extensions.Logging*", "Microsoft.Extensions.DependencyInjection*", "IFX.BuildingBlocks.Domain*", "IFX.BuildingBlocks.Security*"]
  },
  "forbiddenPackages": {
    "Contracts": ["Microsoft.EntityFrameworkCore*", "MediatR*", "Microsoft.AspNetCore*", "Newtonsoft.Json*", "System.Text.Json*", "MassTransit*", "RabbitMQ*", "Azure.Messaging*", "Microsoft.Extensions.DependencyInjection*"],
    "Presentation": ["Microsoft.EntityFrameworkCore*", "Dapper*", "Npgsql*", "System.Data.SqlClient*", "Microsoft.Data.SqlClient*"]
  },
  "declarationNamespaces": [
    { "match": "I*Contract", "kind": "interface", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts*", "exceptions": ["IContractSerializer"] },
    { "match": "*ContractDto", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts*" },
    { "match": "*IntegrationEvent", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Events*" },
    { "match": "*EventV*", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Events*" },
    { "match": "*RequestContext", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Context*" },
    { "match": "*EventEnvelope", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Messaging*" },
    { "match": "I*Port", "kind": "interface", "mustLiveIn": ["Application"], "namespace": "*.Application.Ports*" },
    { "match": "*Adapter", "kind": "class", "mustLiveIn": ["IntegrationAdapter", "Infrastructure"], "namespace": "*.Integrations*", "mustImplement": "Application", "mustImplementOwn": true, "exceptions": ["*InboundAdapter"] },
    { "match": "*InboundAdapter", "kind": "class", "mustLiveIn": ["IntegrationAdapter", "Infrastructure"], "namespace": "*.Integrations*", "mustImplement": "Contracts", "mustImplementOwn": true }
  ],
  "forbiddenDeclarations": [
    { "match": "*Handler", "in": "Contracts" },
    { "match": "*DbContext", "in": "Contracts" },
    { "match": "*Repository", "in": "Contracts" },
    { "match": "*Extensions", "in": "Contracts", "exceptions": ["*ContractExtensions"] },
    { "match": "*", "kind": "class", "in": "Contracts", "exceptions": ["*Dto", "*Request", "*Response", "*Context", "*Envelope", "*Exception", "*Options", "*Constants", "*ContractExtensions"] }
  ],
  "forbiddenNamespaces": {
    "Contracts": ["Microsoft.EntityFrameworkCore*", "MediatR*", "Microsoft.AspNetCore*", "Microsoft.Extensions.DependencyInjection*", "Newtonsoft.Json*", "System.Text.Json*", "MassTransit*", "RabbitMQ*", "Azure.Messaging*"],
    "Application": ["Microsoft.AspNetCore.Http*"]
  },
  "forbiddenSymbols": {
    "Contracts": ["*HttpContext", "*ClaimsPrincipal", "*JwtSecurityToken", "*Activity", "*ILogger", "*IServiceCollection", "*DbContext", "*IRequest", "*ConsumeContext"],
    "Application": ["*HttpContext", "*ClaimsPrincipal", "*JwtSecurityToken", "*Activity", "*ContractRequestContextAccessor", "*EventEnvelopeAccessor"]
  },
  "forbiddenText": {
    "Contracts": ["*Microsoft.AspNetCore*", "*Microsoft.EntityFrameworkCore*", "*MassTransit*", "*RabbitMQ*"],
    "Application": ["*HttpContext*", "*System.Diagnostics.Activity*"]
  },
  "payloads": [
    { "match": "*IntegrationEvent", "forbiddenTypes": ["*.Domain.*", "*.Infrastructure.*", "*Entity", "*DbContext"] },
    { "match": "*EventV*", "forbiddenTypes": ["*.Domain.*", "*.Infrastructure.*", "*Entity", "*DbContext"] },
    { "match": "*RequestContext", "allowedTypes": ["string", "Guid", "Guid?", "DateTimeOffset", "DateTimeOffset?", "bool", "int", "long", "decimal"] },
    { "match": "*EventEnvelope", "allowedTypes": ["string", "Guid", "Guid?", "DateTimeOffset", "DateTimeOffset?", "bool", "int", "long"] }
  ],
  "declarations": [
    { "match": "I*Repository", "kind": "interface", "mustLiveIn": "Domain" },
    { "match": "*Repository", "kind": "class", "mustLiveIn": "Infrastructure", "mustImplement": "Domain", "severity": "bends" },
    { "match": "*CommandHandler", "mustLiveIn": "Application" },
    { "match": "*QueryHandler", "mustLiveIn": "Application" },
    { "match": "*CommandValidator", "mustLiveIn": "Application", "severity": "bends" }
  ],
  "severities": { "RING-PACKAGE": "bends", "RING-PACKAGE-IMPORT": "bends", "PROJECT-NAME-FORBIDDEN": "drift" },
  "sharedPrimitiveProjects": ["IFX.Platform.Context.Contracts", "IFX.Platform.Messaging.Contracts"],
  "claims": [
    "IFX.C1.IMPORT_DIRECTION_SOURCE", "IFX.C1.IMPORT_OWNERSHIP_SOURCE", "IFX.C1.IMPORT_PACKAGE_SOURCE",
    "IFX.C1.DECLARATION_NAMESPACE_SOURCE", "IFX.C1.DECLARATION_FORBIDDEN_SOURCE",
    "IFX.C1.DECLARATION_PLACEMENT_SOURCE", "IFX.C1.DECLARATION_IMPLEMENTS_SOURCE",
    "IFX.C1.SYMBOL_FORBIDDEN_SOURCE", "IFX.C1.PAYLOAD_TYPE_SOURCE"
  ]
}

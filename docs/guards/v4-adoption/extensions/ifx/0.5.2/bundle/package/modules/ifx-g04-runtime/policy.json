    {
      "id": "publicAggregateHasNoDescriptions",
      "family": "health",
      "clauses": [
        {
          "alias": "healthConfig",
          "none": [
            "e\\.Value\\.Description"
          ]
        }
      ]
    },
    {
      "id": "backlogMetricContractComplete",
      "family": "backpressure",
      "clauses": [
        {
          "alias": "backpressurePolicy",
          "jsonArrayAtLeast": {
            "path": "requiredDimensions",
            "count": 11
          }
        }
      ]
    },
    {
      "id": "countAloneCannotTripHealth",
      "family": "backpressure",
      "clauses": [
        {
          "alias": "backpressureImpl",
          "all": [
            "OldestPendingAge >= threshold\\.CriticalAge && observation\\.PendingCount >= threshold\\.CriticalCount && stalled",
            "OldestPendingAge >= threshold\\.WarningAge && observation\\.PendingCount >= threshold\\.WarningCount"
          ]
        }
      ]
    },
    {
      "id": "backpressureIsScoped",
      "family": "backpressure",
      "clauses": [
        {
          "alias": "backpressureImpl",
          "all": [
            "intent\\.ExpandsBacklog",
            "item\\.ModuleId",
            "item\\.EventCategory"
          ]
        }
      ]
    },
    {
      "id": "retrySemanticsStable",
      "family": "backpressure",
      "clauses": [
        {
          "alias": "backpressureImpl",
          "all": [

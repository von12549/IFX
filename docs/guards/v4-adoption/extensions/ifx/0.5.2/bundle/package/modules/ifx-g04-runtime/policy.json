      ]
    },
    {
      "id": "apiEndpointMappingIsRoleGated",
      "family": "role",
      "clauses": [
        {
          "alias": "program",
          "all": [
            "if \\(runtimeProfile\\.Capabilities\\.Api\\)[\\s\\S]*?installer\\.MapEndpoints"
          ]
        }
      ]
    },
    {
      "id": "hangfireClientServerSplit",
      "family": "role",
      "clauses": [
        {
          "alias": "backgroundJobs",
          "all": [
            "AddBackgroundJobsClient",
            "AddBackgroundJobsServer"
          ]
        }
      ]
    },
    {
      "id": "hangfireServerIsRoleGated",
      "family": "role",
      "clauses": [
        {
          "alias": "program",
          "all": [
            "if \\(runtimeProfile\\.Capabilities\\.HangfireServer\\)[\\s\\S]*?AddBackgroundJobsServer"
          ]
        }
      ]
    },
    {
      "id": "sameArtifactApiWorkerCompose",
      "family": "role",
      "clauses": [

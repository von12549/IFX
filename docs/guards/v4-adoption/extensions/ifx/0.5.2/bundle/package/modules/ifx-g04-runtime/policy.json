            "receiver\\.ReceiveAsync"
          ]
        }
      ]
    },
    {
      "id": "receiverRegistered",
      "family": "inbound",
      "clauses": [
        {
          "alias": "registration",
          "all": [
            "AddSingleton<IInboundIntegrationEventReceiver, RawIntegrationEventReceiver>"
          ]
        }
      ]
    },
    {
      "id": "contextValidatedBeforeHandler",
      "family": "inbound",
      "clauses": [
        {
          "alias": "receiver",
          "order": [
            "IntegrationEventTransportCodec.Decode",
            "GetServices<IInboundIntegrationEventHandler>"
          ]
        },
        {
          "alias": "receiver",
          "all": [
            "G05-EVENT-CONTEXT-INVALID",
            "G05-EVENT-TENANT-INVALID"
          ]
        }
      ]
    },
    {
      "id": "invalidTraceRestartsAndSanitizes",
      "family": "inbound",
      "clauses": [
        {
          "alias": "receiver",
          "all": [
            "ActivityContext\\.TryParse",
            "traceRestarted = true",
            "parentContext = default",
            "ActivityKind\\.Consumer"
          ]
        }
      ]
    },
    {
      "id": "boundedTraceTelemetry",
      "family": "inbound",
      "clauses": [
        {
          "alias": "receiver",
          "all": [
            "ifx\\.trace\\.restarted"
          ]
        },
        {
          "alias": "receiver",
          "none": [
            "ILogger|Log(?:Trace|Debug|Information|Warning|Error|Critical)\\s*\\("
          ]
        }
      ]
    },
    {
      "id": "testsCoverInvalidTraceParentAndState",
      "family": "inbound",
      "clauses": [
        {
          "alias": "inboundTests",
          "all": [
            "Invalid_trace_is_restarted_and_sanitized_before_the_real_handler",
            "damaged-trace",
            "invalid\\\\nstate"
          ]
        }
      ]
    },
    {
      "id": "testsCoverContextBeforeHandler",
      "family": "inbound",
      "clauses": [
        {
          "alias": "inboundTests",
          "all": [
            "Invalid_business_context_is_quarantined_before_handler_dispatch",
            "handler\\.Messages\\.Should\\(\\)\\.BeEmpty"
          ]
        }
      ]
    },
    {
      "id": "testsCoverValidParentAndCurrentTransport",
      "family": "inbound",
      "clauses": [
        {
          "alias": "inboundTests",
          "all": [
            "Valid_remote_trace_is_continued_without_changing_the_envelope",
            "In_process_sender_uses_the_raw_transport_boundary"
          ]
        }
      ]
    }

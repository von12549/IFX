          ]
        }
      ]
    },
    {
      "id": "rawCarrierAndReceiverExist",
      "family": "inbound",
      "clauses": [
        {
          "alias": "receiver",
          "all": [
            "record InboundIntegrationEventMessage",
            "interface IInboundIntegrationEventReceiver",
            "class RawIntegrationEventReceiver"
          ]
        }
      ]
    },
    {
      "id": "currentSenderUsesRawBoundary",
      "family": "inbound",
      "clauses": [
        {
          "alias": "sender",
          "all": [

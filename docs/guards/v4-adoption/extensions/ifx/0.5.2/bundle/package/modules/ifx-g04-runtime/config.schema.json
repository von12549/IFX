{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g04-runtime/config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["enabledClaims", "policySha256", "authorityHashes"],
  "properties": {
    "enabledClaims": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": { "enum": ["IFX.C3.G04_ROLE", "IFX.C3.G04_STARTUP", "IFX.C3.G04_WORKER", "IFX.C3.G04_DRAIN", "IFX.C3.G04_HEALTH", "IFX.C3.G04_BACKPRESSURE", "IFX.C3.G04_INBOUND"] } },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorityHashes": { "type": "array", "minItems": 1, "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    } }
  }
}

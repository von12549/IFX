{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-frontend-evidence/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabledClaims",
    "policySha256"
  ],
  "properties": {
    "enabledClaims": {
      "const": [
        "IFX.C5.FRONTEND_QUALITY"
      ]
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

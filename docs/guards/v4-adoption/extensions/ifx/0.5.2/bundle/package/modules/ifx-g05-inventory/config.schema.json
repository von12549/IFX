{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g05-inventory/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabledClaims",
    "policySha256",
    "authorityHashes"
  ],
  "properties": {
    "enabledClaims": {
      "const": [
        "IFX.C4.G05_INVENTORY"
      ]
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorityHashes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}

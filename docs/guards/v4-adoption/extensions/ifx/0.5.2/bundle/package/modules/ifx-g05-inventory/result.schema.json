{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g05-inventory/result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "findings", "coverage"],
  "properties": {
    "formatVersion": {"const": 1},
    "status": {"enum": ["pass", "fail", "error"]},
    "exitCategory": {"enum": ["success", "findings-blocking", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing"]},
    "message": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ruleId", "subject", "evidenceKind", "detectorId", "severity"],
        "properties": {
          "ruleId": {"const": "G05-INVENTORY"},
          "subject": {"type": "string", "minLength": 1},
          "evidenceKind": {"enum": ["source-location", "historical-authority", "coverage"]},
          "detectorId": {"const": "ifx-g05-inventory"},
          "severity": {"const": "blocking"}
        }
      }
    },
    "coverage": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claimId", "matched", "minimum"],
        "properties": {
          "claimId": {"const": "IFX.C4.G05_INVENTORY"},
          "matched": {"type": "integer", "minimum": 0},
          "minimum": {"const": 1}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "project", "sources", "commands", "areas", "riskTriggers", "detectors", "rules", "postFullCommands"],
  "properties": {
    "formatVersion": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "items": { "type": "object" } },
    "commands": { "type": "array", "items": { "type": "object" } },
    "areas": { "type": "array", "items": { "type": "object" } },
    "riskTriggers": { "type": "array", "items": { "type": "object" } },
    "detectors": { "type": "array", "items": { "type": "object" } },
    "rules": { "type": "array", "items": { "type": "object" } },
    "postFullCommands": { "type": "array", "items": { "type": "string" } }
  }
}

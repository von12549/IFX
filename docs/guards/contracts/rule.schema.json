{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "title", "authority", "scopePatterns", "riskTriggerIds", "stages", "enforcement", "coverage", "detectors", "limitations", "evidenceRequirement"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "selector": { "type": "string" }
      }
    },
    "scopePatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "riskTriggerIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "stages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["pre", "post", "diff", "ci"] } },
    "enforcement": { "enum": ["blocking", "advisory"] },
    "coverage": { "enum": ["full", "partial", "none", "out-of-scope"] },
    "detectors": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "limitations": { "type": "string" },
    "evidenceRequirement": { "type": "string", "minLength": 1 }
  }
}

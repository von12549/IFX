{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile", "detectors", "postFullCommands"],
  "properties": {
    "formatVersion": { "const": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "detectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commandId", "ciJob", "coverage"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "commandId": { "type": "string", "minLength": 1 },
          "ciJob": { "type": "string", "minLength": 1 },
          "ciWorkflow": { "type": "string", "minLength": 1 },
          "coverage": { "enum": ["full", "partial"] }
        }
      }
    },
    "postFullCommands": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}

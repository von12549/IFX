{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "gateId", "stage", "status", "scope", "ruleIds", "inputHash", "checks", "evidencePaths", "reason"],
  "properties": {
    "formatVersion": { "const": 1 },
    "gateId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["pre", "post", "diff", "regeneration"] },
    "status": { "enum": ["pass", "fail", "not-run", "blocked", "advisory"] },
    "scope": { "type": "string" },
    "ruleIds": { "type": "array", "items": { "type": "string" } },
    "inputHash": { "type": "string" },
    "checks": { "type": "array", "items": { "type": "object" } },
    "evidencePaths": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" }
  }
}

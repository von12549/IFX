{
  "formatVersion": 1,
  "id": "20260926-v4-p10-1-host-workspace-evidence",
  "title": "Promote shared workspace evidence to a V4 Host capability",
  "goal": "Have the trusted V4 Host create one deterministic workspace evidence projection per run and expose it only to modules with reviewed EvidenceRoot access.",
  "acceptanceCriteria": [
    "The Profile and workspace-evidence schemas define a bounded generic source projection without adding an untrusted CLI evidence override.",
    "The Host generates exactly one ordinal, duplicate-free, link-safe evidence document per run, binds it to target commit and authority hashes, and writes only below the project/run EvidenceRoot.",
    "Only modules declaring EvidenceRoot receive workspaceEvidencePath, workspaceEvidenceSha256 and workspaceEvidenceTargetCommit; Profiles without workspaceEvidence remain compatible.",
    "Synthetic Host tests verify schema, hashes, ordering, capability gating and four-root immutability.",
    "The seven existing IFX consumers accept the generic V4 scope, retain direct-scan fallback behavior, and pass their focused tests with refreshed locks.",
    "Formal Pre/Diff and the affected V4 and IFX focused suites pass; publication and full C6c rerun remain a separate patch-release tranche."
  ],

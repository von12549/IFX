{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3 deployment activation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "schema", "packageId", "commandsManifest", "artifacts", "validators"],
  "properties": {
    "formatVersion": { "const": 1 },
    "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.json$" },
    "packageId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "commandsManifest": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.json$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "template", "candidate", "target"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "kind": { "enum": ["full-file", "managed-block"] },
          "template": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
          "variables": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.json$" },
          "variablesSchema": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.json$" },
          "candidate": { "type": "string", "pattern": "^artifacts/generated/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" },
          "marker": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "managed-block" } } }, "then": { "required": ["marker"] } },
          { "if": { "required": ["variables"] }, "then": { "required": ["variablesSchema"] } }
        ]
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commandId", "arguments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "commandId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "arguments": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

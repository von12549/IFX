{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 protected change authorization",
  "description": "Base pre-authorization consumed and deleted by the change PR (Plan 06 §12.1–§12.3). P2 enables change-trusted-base (§11.5); P4 adds move, delete, case-rename and weaken-policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "operation",
    "planPath",
    "decisionPaths",
    "changedPaths",
    "components",
    "entries",
    "validationSuite",
    "parityContract",
    "allowedBehaviorDifferences"
  ],
  "definitions": {
    "tuple": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "type",
        "objectId"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{6}$"
        },
        "type": {
          "enum": [
            "blob",
            "tree",
            "commit"
          ]
        },
        "objectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "repoPath": {
      "type": "string",
      "pattern": "^[^/\u0000][^\u0000]*$",
      "minLength": 1
    }
  },
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "operation": {
      "enum": [
        "change-trusted-base"
      ]
    },
    "planPath": {
      "$ref": "#/definitions/repoPath"
    },
    "decisionPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repoPath"
      }
    },
    "changedPaths": {
      "description": "Exact trusted-component changed-path set, excluding authorization records.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repoPath"
      }
    },
    "components": {
      "description": "Trusted component IDs whose content changes.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tcb\\.[a-z0-9.-]+$"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "component",
          "base",
          "head"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/repoPath"
          },
          "component": {
            "type": "string",
            "pattern": "^tcb\\.[a-z0-9.-]+$"
          },
          "base": {
            "$ref": "#/definitions/tuple"
          },
          "head": {
            "$ref": "#/definitions/tuple"
          }
        }
      }
    },
    "validationSuite": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parityContract": {
      "type": "string",
      "minLength": 1
    },
    "allowedBehaviorDifferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "reason"
        ],
        "properties": {
          "mode": {
            "enum": [
              "Validate",
              "HistoricalIntegrity",
              "G03",
              "G04",
              "G05",
              "Plan04"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

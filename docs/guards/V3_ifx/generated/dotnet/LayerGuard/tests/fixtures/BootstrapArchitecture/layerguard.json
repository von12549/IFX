{
  "rings": {
    "Domain": ["Acme.*.Domain"],
    "Contracts": ["Acme.*.Contracts", "Acme.*.Abstractions"],
    "Application": ["Acme.*.Application"],
    "Presentation": ["Acme.*.Presentation"],
    "IntegrationAdapter": ["Acme.*.Integration"],
    "Infrastructure": ["Acme.*.Infrastructure"],
    "Composition": ["Acme.*.Composition"],
    "RuntimeHost": ["Acme.ApiHost"]
  },
  "ownership": { "modulePatterns": ["Acme.{module}.*"], "requireKnown": true },
  "allowedDependencies": {
    "Domain": [], "Contracts": [], "Application": ["Domain", "Contracts"],
    "Presentation": ["Application"], "IntegrationAdapter": ["Application", "Contracts"],
    "Infrastructure": ["Application", "Domain", "Contracts"],
    "Composition": ["Domain", "Contracts", "Application", "Presentation", "IntegrationAdapter", "Infrastructure"],
    "RuntimeHost": ["Composition"]
  },
  "referenceScopes": [
    { "from": "Application", "to": "Domain", "ownership": "own" },
    { "from": "Application", "to": "Contracts", "ownership": "none" },
    { "from": "IntegrationAdapter", "to": "Application", "ownership": "own" },
    { "from": "IntegrationAdapter", "to": "Contracts", "ownership": "foreign" },
    { "from": "Infrastructure", "to": "Contracts", "ownership": "any" },
    { "from": "RuntimeHost", "to": "Composition", "ownership": "any" }
  ],
  "providerContracts": { "Billing": ["Sales"] },
  "transitiveBoundaryRoles": ["Composition"],
  "embeddedAdapterNamespaces": ["Acme.*.Infrastructure.Integrations*"],
  "forbiddenProjectNames": ["*.Abstractions"],
  "forbiddenNamespaces": { "Contracts": ["Microsoft.AspNetCore*"] },
  "forbiddenSymbols": { "Contracts": ["*HttpContext", "*Activity"] },
  "forbiddenText": { "Contracts": ["*MassTransit*"] },
  "declarationNamespaces": [
    { "match": "*IntegrationEvent", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Events*" },
    { "match": "*RequestContext", "mustLiveIn": ["Contracts"], "namespace": "*.Contracts.Context*" },
    { "match": "I*Port", "kind": "interface", "mustLiveIn": ["Application"], "namespace": "*.Application.Ports*" },
    { "match": "*Adapter", "kind": "class", "mustLiveIn": ["IntegrationAdapter", "Infrastructure"], "namespace": "*.Integrations*", "mustImplement": "Application", "mustImplementOwn": true, "exceptions": ["*InboundAdapter"] },
    { "match": "*InboundAdapter", "kind": "class", "mustLiveIn": ["IntegrationAdapter", "Infrastructure"], "namespace": "*.Integrations*", "mustImplement": "Contracts", "mustImplementOwn": true }
  ],
  "forbiddenDeclarations": [
    { "match": "*Handler", "in": "Contracts", "exceptions": ["CompatibilityHandler"] },
    { "match": "*DbContext", "in": "Contracts" },
    { "match": "*", "kind": "class", "in": "Contracts", "exceptions": ["*Context", "CompatibilityHandler"] }
  ],
  "payloads": [
    { "match": "*IntegrationEvent", "forbiddenTypes": ["*.Domain.*", "*Entity"] },
    { "match": "*RequestContext", "allowedTypes": ["Guid", "DateTimeOffset", "string"] }
  ]
}

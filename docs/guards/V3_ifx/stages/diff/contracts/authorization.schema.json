{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 protected change authorization",
  "description": "Base pre-authorization consumed and deleted by the change PR (Plan 06 §12.1–§12.3). Every operation of §12.2 has a schema; an operation the base verifier has not enabled fails closed when a change tries to consume it (D23); weaken-policy is enabled from CP06b1 (D24). Format 1 change-trusted-base records from P2 stay valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "operation",
    "planPath",
    "decisionPaths",
    "changedPaths"
  ],
  "definitions": {
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "type",
        "objectId"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{6}$"
        },
        "type": {
          "enum": [
            "blob",
            "tree",
            "commit"
          ]
        },
        "objectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "optionalTuple": {
      "oneOf": [
        {
          "$ref": "#/definitions/tuple"
        },
        {
          "type": "null"
        }
      ]
    },
    "repoPath": {
      "type": "string",
      "pattern": "^[^/\u0000][^\u0000]*[^/\u0000]$|^[^/\u0000]$",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "operation": {
      "enum": [
        "move",
        "delete",
        "case-rename",
        "weaken-policy",
        "change-trusted-base"
      ]
    },
    "planPath": {
      "$ref": "#/definitions/repoPath"
    },
    "decisionPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repoPath"
      }
    },
    "changedPaths": {
      "description": "Exact changed-path set the operation covers, excluding authorization records: trusted component paths for change-trusted-base, every file path below source and destination for path operations, authority paths for weaken-policy.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repoPath"
      }
    },
    "components": {
      "description": "change-trusted-base: trusted component IDs whose content changes.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tcb\\.[a-z0-9.-]+$"
      }
    },
    "entries": {
      "description": "Per-path base and head tuples. change-trusted-base entries also name their component.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "base",
          "head"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/repoPath"
          },
          "component": {
            "type": "string",
            "pattern": "^tcb\\.[a-z0-9.-]+$"
          },
          "base": {
            "$ref": "#/definitions/optionalTuple"
          },
          "head": {
            "$ref": "#/definitions/optionalTuple"
          }
        }
      }
    },
    "validationSuite": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parityContract": {
      "type": "string",
      "minLength": 1
    },
    "allowedBehaviorDifferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "reason"
        ],
        "properties": {
          "mode": {
            "enum": [
              "Validate",
              "HistoricalIntegrity",
              "G03",
              "G04",
              "G05",
              "Plan04"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "description": "Path operations: the protected source and its base tree entry (a tree for a directory).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "base"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/repoPath"
        },
        "base": {
          "$ref": "#/definitions/tuple"
        }
      }
    },
    "destination": {
      "description": "move and case-rename: the destination, its base precondition (null when absent) and its expected head tree entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "base",
        "head"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/repoPath"
        },
        "base": {
          "$ref": "#/definitions/optionalTuple"
        },
        "head": {
          "$ref": "#/definitions/tuple"
        }
      }
    },
    "policies": {
      "description": "weaken-policy: each registered policy or configuration file whose semantic change the record authorizes (D24).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "baseSha256",
          "headSha256",
          "schema",
          "pointers",
          "head"
        ],
        "properties": {
          "path": {
            "$ref": "#/definitions/repoPath"
          },
          "baseSha256": {
            "description": "SHA-256 of the blob at the merge base; null when head adds the file.",
            "oneOf": [
              {
                "$ref": "#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "headSha256": {
            "description": "SHA-256 of the head blob; null when head removes the file.",
            "oneOf": [
              {
                "$ref": "#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema": {
            "description": "The registered schema path of the file, or its registered format (json, normalized-text) when it has no schema.",
            "type": "string",
            "minLength": 1
          },
          "pointers": {
            "description": "Exactly the changed JSON Pointers; the empty string is the whole document.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(/.*)?$"
            }
          },
          "head": {
            "$ref": "#/definitions/optionalTuple"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "change-trusted-base"
          }
        }
      },
      "then": {
        "required": [
          "components",
          "entries",
          "validationSuite",
          "parityContract",
          "allowedBehaviorDifferences"
        ],
        "properties": {
          "entries": {
            "items": {
              "required": [
                "component"
              ]
            }
          },
          "source": false,
          "destination": false,
          "policies": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "move",
              "case-rename"
            ]
          }
        }
      },
      "then": {
        "required": [
          "source",
          "destination",
          "entries"
        ],
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "component": false
              }
            }
          },
          "components": false,
          "validationSuite": false,
          "parityContract": false,
          "allowedBehaviorDifferences": false,
          "policies": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        }
      },
      "then": {
        "required": [
          "source",
          "entries"
        ],
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "component": false,
                "head": {
                  "type": "null"
                }
              }
            }
          },
          "components": false,
          "validationSuite": false,
          "parityContract": false,
          "allowedBehaviorDifferences": false,
          "destination": false,
          "policies": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "weaken-policy"
          }
        }
      },
      "then": {
        "required": [
          "policies"
        ],
        "properties": {
          "components": false,
          "entries": false,
          "validationSuite": false,
          "parityContract": false,
          "allowedBehaviorDifferences": false,
          "source": false,
          "destination": false
        }
      }
    }
  ]
}

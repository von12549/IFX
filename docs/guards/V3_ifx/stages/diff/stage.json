{
  "formatVersion": 1,
  "id": "diff",
  "commands": [
    "ifx-guardrails",
    "v3-runner",
    "ifx-trusted-base-authorization"
  ],
  "dependencies": [
    "pre"
  ],
  "enforcement": "blocking",
  "executionClass": "gate",
  "documentation": [
    "docs/guards/V3_ifx/examples/plan/README.md"
  ],
  "gates": [
    {
      "id": "v3-pre-diff",
      "executionClass": "gate",
      "trustContract": {
        "type": "judging",
        "evaluator": "base V3 engine, Diff configuration and authorizations",
        "policy": "protected guard paths from package stages/diff/protection.json, authorization records, and the policy and configuration registry shared/policy-config.json with the base authority registry",
        "targetInput": "Git objects of verified merge-base and head",
        "inputs": [
          {
            "ref": "package:shared/profile-layout.json",
            "source": "base"
          },
          {
            "ref": "package:stages/diff/protection.json",
            "source": "base"
          },
          {
            "ref": "package:shared/policy-config.json",
            "source": "base"
          },
          {
            "ref": "package:shared/authorities/authorities.json",
            "source": "base"
          },
          {
            "ref": "target:docs/guards/plans/",
            "source": "head-target"
          },
          {
            "ref": "target:docs/guards/V3_ifx/shared/decisions/history/",
            "source": "head-target"
          }
        ],
        "executesHead": false,
        "consumesHeadArtifacts": false,
        "knownGaps": [],
        "guarantee": "Base fully owns the verdict within Plan 06 §11.4."
      }
    }
  ]
}

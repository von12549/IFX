{
  "formatVersion": 1,
  "id": "post",
  "commands": [
    "ifx-guardrails",
    "v3-runner",
    "v3-docs",
    "ifx-architecture",
    "ifx-specialized",
    "ifx-quality",
    "ifx-historical-integrity",
    "ifx-policy-sync",
    "ifx-history-manifest"
  ],
  "dependencies": [],
  "enforcement": "blocking",
  "executionClass": "gate",
  "documentation": [
    "docs/guards/V3_ifx/README.md",
    "docs/guards/V3_ifx/analysis/ifx/refactor-baseline/trust-contracts.json",
    "docs/guards/V3_ifx/docs/generated/POST.md"
  ],
  "gates": [
    {
      "id": "v3-architecture",
      "executionClass": "gate",
      "trustContract": {
        "type": "mixed",
        "evaluator": "base generic Architecture Conformance engine (docs/guards/V3/stages/post/gates/architecture/dotnet/Guards.ArchitectureConformance), run through the base IFX host that registers the IFX policy binding (docs/guards/V3_ifx/templates/ifx-layerguard/src/LayerGuard.Ifx)",
        "policy": "docs/guards/V3_ifx/stages/post/policy/layerguard.json",
        "targetInput": "head csproj XML and C# source text; head guard package tests",
        "inputs": [
          {
            "ref": "package:stages/post/policy/layerguard.json",
            "source": "base"
          },
          {
            "ref": "package:stages/post/policy/baselines/",
            "source": "base"
          },
          {
            "ref": "package:shared/profile-layout.json",
            "source": "base"
          },
          {
            "ref": "package:shared/authorities/authorities.json",
            "source": "base"
          },
          {
            "ref": "package:stages/post/policy/g03/",
            "source": "derived-candidate"
          },
          {
            "ref": "package:stages/post/policy/g04/",
            "source": "derived-candidate"
          },
          {
            "ref": "package:stages/post/policy/g05/",
            "source": "derived-candidate"
          },
          {
            "ref": "authority:database-migration-manifest",
            "source": "head-candidate"
          },
          {
            "ref": "authority:database-release-manifest",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g03-contract-event-catalog",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g03-layerguard-governance-input",
            "source": "derived-candidate"
          },
          {
            "ref": "authority:g04-backpressure-policy",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-deployment-unit-catalog",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-failure-matrix",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-infrastructure-compatibility",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-module-manifest",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-release-orchestration",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g04-release-runtime-manifest",
            "source": "derived-candidate"
          },
          {
            "ref": "authority:g05-context-protocol",
            "source": "head-candidate"
          },
          {
            "ref": "target:src/",
            "source": "head-target"
          },
          {
            "ref": "target:docs/guards/V3_ifx/tests/",
            "source": "head-target"
          }
        ],
        "executesHead": false,
        "consumesHeadArtifacts": false,
        "knownGaps": [
          "layerguard-msbuild-evaluation",
          "layerguard-generated-sources"
        ],
        "guarantee": "Evaluator, policy binding and policy all come from base; the verdict covers project references, rings, ownership, declarations, packages, imports and the G03/G04/G05 bindings as declared in csproj XML and C# source text, with the composite policy hash bound to the reviewed baseline. Blind to references and properties that only exist after MSBuild evaluation (imports, Conditions, SDK defaults, generated items), which v3-quality-assembly cross-covers by checking the compiled assemblies of the same commit; blind to runtime behaviour, which the quality and specialized gates cover.",
        "policyBinding": "IFX G03/G04/G05 binding in the base package; the engine reads no repository policy of its own and fails closed when a configuration binds a section for which the host registered no binding",
        "crossCover": [
          {
            "gap": "layerguard-msbuild-evaluation",
            "coveredBy": "v3-quality-assembly",
            "how": "compiled assembly references of the five Domain assemblies are checked after a real build, so a reference that only appears through an MSBuild import or Condition still fails a required check"
          },
          {
            "gap": "layerguard-generated-sources",
            "coveredBy": "v3-quality-solution",
            "how": "the solution build and tests compile generated sources, so a violation introduced by a generator fails there"
          }
        ],
        "importInjectionRule": "a detection rule for MSBuild import injection is registered as a standalone rule proposal only (Plan 06 P6.5); it is not part of this gate today"
      }
    },
    {
      "id": "v3-specialized-g03",
      "executionClass": "gate",
      "trustContract": {
        "type": "judging",
        "evaluator": "base G03 detectors",
        "policy": "governing-policy and exception-authorization pointers of the head-candidate G03 catalog (Plan 06 D18); blocking findings pass only with a base weaken-policy authorization recomputed for the explicit head commit (D25)",
        "targetInput": "head contract/event source and documentation text",
        "detectors": [
          "stages/post/gates/specialized/scripts/Invoke-G03ContractEventGuard.ps1"
        ],
        "inputs": [
          {
            "ref": "authority:g03-contract-event-catalog",
            "source": "head-candidate"
          },
          {
            "ref": "authority:g03-layerguard-governance-input",
            "source": "derived-candidate"
          },
          {
            "ref": "authority:g03-serialization-golden",
            "source": "derived-candidate"
          },
          {
            "ref": "authority:g03-sync-api-snapshot",
            "source": "derived-candidate"
          },
          {
            "ref": "target:src/",
            "source": "head-target"
          },
          {
            "ref": "target:docs/architecture/review/",
            "source": "head-target"
          }
        ],
        "executesHead": false,
        "consumesHeadArtifacts": false,
        "knownGaps": [],
        "guarantee": "Base owns the verdict; detectors are static."
      }
    },

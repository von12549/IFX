{
  "formatVersion": 1,
  "workflow": "V3 IFX Guardrails",
  "automaticGuardWorkflow": ".github/workflows/v3-ifx-guardrails.yml",
  "mergeEnforcement": "github-ruleset-required-checks",
  "ruleset": { "id": 23459908, "name": "IFX V3 Required Checks", "strict": true, "requiredCheckCount": 13 },
  "legacyWorkflowMode": "deleted-after-required-check-proof",
  "trustedBase": { "execution": "active", "tcbCandidateVerification": "active" },
  "costControls": {
    "scheduleCron": "17 3 1 * *",
    "concurrencyGroup": "v3-ifx-guardrails-${{ github.event.pull_request.number || github.ref }}",
    "cancelSupersededRuns": true,
    "packageCache": {
      "action": "actions/cache@v4",
      "path": "~/.nuget/packages",
      "keyPrefix": "guard-nuget-",
      "lockGlob": "docs/guards/*/build/locks/*.packages.lock.json",
      "jobs": ["v3-architecture", "v3-quality-solution", "v3-specialized-database", "v3-cross-platform"]
    },
    "windowsPortability": {
      "candidateFacade": "docs/guards/V3_ifx/commands/Invoke-IFXGuardrails.ps1",
      "requiredCheck": "v3-cross-platform-windows-latest",
      "runner": "windows-latest",
      "ordinaryCoverage": "smoke",
      "fullCertificationEvent": "workflow_dispatch",
      "fullCertificationInput": "windowsCoverage",
      "fullCertificationValue": "full",
      "fullCertificationCheckpoint": "P11.4",
      "smokeCommands": [
        "docs/guards/V3/commands/Invoke-V3.ps1 -Mode Generate",
        "docs/guards/V3/commands/Invoke-V3.ps1 -Mode Check",
        "docs/guards/V3_ifx/commands/Invoke-IFXArchitecture.ps1 -Mode Generate",
        "docs/guards/V3_ifx/commands/Invoke-IFXArchitecture.ps1 -Mode Check",
        "docs/guards/V3/tests/Test-V3BuildBaseline.ps1",
        "docs/guards/V3_ifx/tests/support/Test-IFXTargetRootSeparation.ps1"
      ],
      "fullSuiteCommands": [
        "docs/guards/V3/commands/Invoke-V3.ps1 -Mode Generate",
        "docs/guards/V3/commands/Invoke-V3.ps1 -Mode Check",
        "docs/guards/V3_ifx/commands/Invoke-IFXArchitecture.ps1 -Mode Generate",
        "docs/guards/V3_ifx/commands/Invoke-IFXArchitecture.ps1 -Mode Check",
        "docs/guards/V3/tests/Test-V3.ps1",
        "docs/guards/V3/tests/Test-V3BuildBaseline.ps1",
        "docs/guards/V3_ifx/tests/pre/Test-IFXPre.ps1",
        "docs/guards/V3_ifx/tests/support/Test-IFXAuthorityProjection.ps1",
        "docs/guards/V3_ifx/tests/post/Test-IFXSpecializedContracts.ps1",
        "docs/guards/V3_ifx/tests/post/Test-IFXHistoricalIntegrity.ps1",
        "docs/guards/V3_ifx/tests/ci/Test-IFXDeployment.ps1",
        "docs/guards/V3_ifx/tests/support/Test-IFXTargetRootSeparation.ps1",
        "docs/guards/V3_ifx/tests/support/Test-IFXDomainAuthorityCandidates.ps1",
        "docs/guards/V3_ifx/tests/support/Test-IFXTrustedBase.ps1"
      ]
    }
  },
  "changeScope": {
    "entryPoint": "docs/guards/V3_ifx/commands/Invoke-IFXGuardrails.ps1",
    "mode": "Scope",
    "implementation": "docs/guards/V3_ifx/trusted-base/Get-IFXChangeScope.ps1",
    "inheritScope": "records-and-plans",
    "candidateStepJobs": ["v3-architecture", "v3-cross-platform"],
    "inheritingChecks": ["v3-architecture", "v3-quality-solution", "v3-quality-assembly", "v3-quality-frontend", "v3-specialized-database"]
  },
  "jobs": [
    { "id": "v3-pre-diff", "mode": "diff", "trigger": "pull-request", "blocking": true },
    { "id": "v3-architecture", "mode": "architecture", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-specialized-g03", "mode": "specialized", "gate": "g03", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-specialized-g04", "mode": "specialized", "gate": "g04", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-specialized-g05", "mode": "specialized", "gate": "g05", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-specialized-plan04", "mode": "specialized", "gate": "plan04", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-specialized-database", "mode": "specialized", "gate": "database", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-quality-solution", "mode": "quality", "gate": "solution", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-quality-assembly", "mode": "quality", "gate": "assembly", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-quality-frontend", "mode": "quality", "gate": "frontend", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-historical-integrity", "mode": "historical-integrity", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-cross-platform-ubuntu-latest", "mode": "validate", "trigger": "pull-request-and-main", "blocking": true },
    { "id": "v3-cross-platform-windows-latest", "mode": "validate", "trigger": "pull-request-and-main", "blocking": true }
  ]
}

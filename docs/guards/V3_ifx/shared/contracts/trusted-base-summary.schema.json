{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IFX trusted base run summary",
  "description": "Plan 06 §11.1/§11.3: provenance of a guard run executed from the base worktree against an explicit head target, with the gate guarantee it can claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "mode",
    "status",
    "baseSha",
    "headSha",
    "baseRepository",
    "targetRoot",
    "candidatePackage",
    "gate",
    "checks"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "Validate",
        "Pre",
        "Diff",
        "Architecture",
        "Specialized",
        "Quality",
        "HistoricalIntegrity"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "headSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseRepository": {
      "type": "string",
      "minLength": 1
    },
    "targetRoot": {
      "type": "string",
      "minLength": 1
    },
    "candidatePackage": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "guarantee",
        "knownGaps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "judging",
            "mixed",
            "executing"
          ]
        },
        "guarantee": {
          "type": "string"
        },
        "knownGaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

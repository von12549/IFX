{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 stage manifest (owns stage fields only; command fields live in commands.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "commands",
    "dependencies",
    "enforcement",
    "executionClass",
    "documentation",
    "gates"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "enum": [
        "bootstrap",
        "analysis",
        "pre",
        "post",
        "diff",
        "ci"
      ]
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bootstrap",
          "analysis",
          "pre",
          "post",
          "diff",
          "ci"
        ]
      }
    },
    "enforcement": {
      "enum": [
        "advisory",
        "blocking",
        "mixed"
      ]
    },
    "executionClass": {
      "enum": [
        "authoring",
        "gate",
        "governance-audit",
        "orchestration"
      ]
    },
    "documentation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "executionClass",
          "trustContract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "executionClass": {
            "enum": [
              "gate",
              "governance-audit"
            ]
          },
          "trustContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "evaluator",
              "policy",
              "targetInput",
              "inputs",
              "executesHead",
              "consumesHeadArtifacts",
              "knownGaps",
              "guarantee"
            ],
            "properties": {
              "type": {
                "enum": [
                  "judging",
                  "mixed",
                  "executing"
                ]
              },
              "evaluator": {
                "type": "string",
                "minLength": 1
              },
              "policy": {
                "type": "string",
                "minLength": 1
              },
        "policyBinding": {
          "description": "Plan 06 P6.5: where the repository policy binding comes from, for a gate whose engine carries no policy of its own.",
          "type": "string",
          "minLength": 1
        },
        "crossCover": {
          "description": "Plan 06 P6.5: which other required check covers each known blind spot of this gate, and how.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gap", "coveredBy", "how"],
            "properties": {
              "gap": { "type": "string", "minLength": 1 },
              "coveredBy": { "type": "string", "minLength": 1 },
              "how": { "type": "string", "minLength": 1 }
            }
          }
        },
        "importInjectionRule": {
          "description": "Plan 06 P6.5: the status of the MSBuild import injection detection rule, which is registered as a standalone proposal rather than part of the gate.",
          "type": "string",
          "minLength": 1
        },
              "targetInput": {
                "type": "string",
                "minLength": 1
              },
              "detectors": {
                "description": "Package-relative detector entry scripts; their static read closure must be covered by authority inputs.",
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.ps1$"
                }
              },
              "inputs": {
                "description": "Trust inputs and where each comes from (Plan 06 §11.3, D18): base package, head candidate authority, candidate projection derived by the base generator, or head target data.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "source"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^(authority:[a-z0-9][a-z0-9-]*|package:[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*/?|target:[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*/?)$"
                    },
                    "source": {
                      "enum": [
                        "base",
                        "head-candidate",
                        "derived-candidate",
                        "head-target"
                      ]
                    }
                  }
                }
              },
              "executesHead": {
                "type": "boolean"
              },
              "consumesHeadArtifacts": {
                "type": "boolean"
              },
              "knownGaps": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "guarantee": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

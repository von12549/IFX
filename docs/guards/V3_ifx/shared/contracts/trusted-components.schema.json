{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 trusted base component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifest",
    "components"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "verifier"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "status",
          "paths",
          "validationSuite",
          "parityContract",
          "allowedChange"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tcb\\.[a-z0-9.-]+$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "planned"
            ]
          },
          "paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "plannedPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validationSuite": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parityContract": {
            "type": "string",
            "minLength": 1
          },
          "allowedChange": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 command manifest (owns command fields only; stage fields live in stage.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "commands"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "entryPoint",
          "stages",
          "audiences",
          "inputs",
          "outputs",
          "evidence",
          "mutability",
          "requiresExplicitAcceptance",
          "platforms",
          "stability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "public",
              "internal",
              "maintenance"
            ]
          },
          "entryPoint": {
            "type": "string",
            "minLength": 1
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "bootstrap",
                "analysis",
                "pre",
                "post",
                "diff",
                "ci"
              ]
            }
          },
          "audiences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ci",
                "human",
                "agent",
                "validation-command"
              ]
            }
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutability": {
            "enum": [
              "read-only",
              "writes-artifacts",
              "writes-generated",
              "writes-authority",
              "writes-activation"
            ]
          },
          "requiresExplicitAcceptance": {
            "type": "boolean"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "linux",
                "windows"
              ]
            }
          },
          "stability": {
            "enum": [
              "stable",
              "internal",
              "deprecated"
            ]
          }
        }
      }
    }
  }
}

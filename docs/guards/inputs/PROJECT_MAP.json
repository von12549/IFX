{
  "formatVersion": 1,
  "areas": [
    { "id": "IAM", "pathPattern": "src/Modules/IAM/**", "layer": "module", "ownerSource": "g03:IAM", "focusedCommands": ["layerguard-focused", "iam-tests"] },
    { "id": "CRM", "pathPattern": "src/Modules/CRM/**", "layer": "module", "ownerSource": "g03:CRM", "focusedCommands": ["layerguard-focused", "crm-tests"] },
    { "id": "Registry", "pathPattern": "src/Modules/Registry/**", "layer": "module", "ownerSource": "g03:Registry", "focusedCommands": ["layerguard-focused", "registry-tests"] },
    { "id": "Holdings", "pathPattern": "src/Modules/Holdings/**", "layer": "module", "ownerSource": "g03:Holdings", "focusedCommands": ["layerguard-focused", "holdings-tests"] },
    { "id": "Transaction", "pathPattern": "src/Modules/Transaction/**", "layer": "module", "ownerSource": "g03:Transaction", "focusedCommands": ["layerguard-focused", "transaction-tests"] },
    { "id": "Authentication", "pathPattern": "src/Platform/Authentication/**", "layer": "platform", "ownerSource": "g03:Authentication", "focusedCommands": ["layerguard-focused", "authentication-tests"] },
    { "id": "Authorization", "pathPattern": "src/Platform/Authorization/**", "layer": "platform", "ownerSource": "g03:Authorization", "focusedCommands": ["layerguard-focused", "authorization-tests"] },
    { "id": "Frontend", "pathPattern": "src/Frontend/**", "layer": "frontend", "ownerSource": "codeowners", "focusedCommands": ["frontend-lint", "frontend-test", "frontend-build"] },
    { "id": "GuardFramework", "pathPattern": "docs/guards/**", "layer": "tooling", "ownerSource": "codeowners", "focusedCommands": ["guard-selftest"] },
    { "id": "GuardScripts", "pathPattern": "scripts/guards/**", "layer": "tooling", "ownerSource": "codeowners", "focusedCommands": ["guard-selftest"] }
  ],
  "riskTriggers": [
    { "id": "public-contract", "pathPattern": "src/**/IFX.*.Contracts/**", "reason": "Public contract or protocol change", "requiresDecision": true },
    { "id": "database-migration", "pathPattern": "src/**/Migrations/**", "reason": "Database migration or schema change", "requiresDecision": true },
    { "id": "database-migrator", "pathPattern": "src/DatabaseMigrator/**", "reason": "Database release boundary", "requiresDecision": true },
    { "id": "identity-security", "pathPattern": "src/Modules/IAM/**", "reason": "IAM and tenant boundary", "requiresDecision": true },
    { "id": "authentication", "pathPattern": "src/Platform/Authentication/**", "reason": "Authentication boundary", "requiresDecision": true },
    { "id": "authorization", "pathPattern": "src/Platform/Authorization/**", "reason": "Authorization boundary", "requiresDecision": true },
    { "id": "frontend-auth", "pathPattern": "src/Frontend/IFX.FrontEnd/src/**/auth/**", "reason": "Frontend sign-in and registration flow", "requiresDecision": true },
    { "id": "frontend-auth-context", "pathPattern": "src/Frontend/IFX.FrontEnd/src/contexts/AuthContext.tsx", "reason": "Frontend authentication session context", "requiresDecision": true },
    { "id": "messaging", "pathPattern": "src/Platform/Messaging/**", "reason": "Message delivery and contract boundary", "requiresDecision": true },
    { "id": "dotnet-dependency", "pathPattern": "**/*.csproj", "reason": ".NET project or package dependency change", "requiresDecision": true },
    { "id": "frontend-dependency", "pathPattern": "src/Frontend/**/package.json", "reason": "Frontend dependency or script change", "requiresDecision": true },
    { "id": "frontend-lockfile", "pathPattern": "src/Frontend/**/package-lock.json", "reason": "Locked frontend dependency change", "requiresDecision": true },
    { "id": "deployment", "pathPattern": "deployment/**", "reason": "Deployment and runtime boundary", "requiresDecision": true },
    { "id": "gate-authority", "pathPattern": "src/layerguard.json", "reason": "LayerGuard policy authority", "requiresDecision": true },
    { "id": "gate-baseline", "pathPattern": "mcp/LayerGuard/baselines/**", "reason": "Architecture waiver baseline", "requiresDecision": true },
    { "id": "layerguard-runtime", "pathPattern": "mcp/LayerGuard/**", "reason": "LayerGuard validator or test change", "requiresDecision": true },
    { "id": "gate-input", "pathPattern": "docs/architecture/review/gates/**", "reason": "Gate authority or derived input", "requiresDecision": true },
    { "id": "gate-validator", "pathPattern": "scripts/*Guard*.ps1", "reason": "Existing gate validator entry change", "requiresDecision": true },
    { "id": "guard-rules", "pathPattern": "docs/guards/inputs/**", "reason": "Guard rule or project profile", "requiresDecision": true },
    { "id": "guard-binding", "pathPattern": "docs/guards/bindings/**", "reason": "Guard detector binding", "requiresDecision": true },
    { "id": "guard-contract", "pathPattern": "docs/guards/contracts/**", "reason": "Guard input or result contract", "requiresDecision": true },
    { "id": "guard-runtime", "pathPattern": "scripts/guards/**", "reason": "Guard framework code", "requiresDecision": true },
    { "id": "gate-review-routing", "pathPattern": ".github/CODEOWNERS", "reason": "Required owner review routing", "requiresDecision": true },
    { "id": "gate-line-endings", "pathPattern": ".gitattributes", "reason": "Checkout byte normalization for bound policies and generated artifacts", "requiresDecision": true },
    { "id": "ci-workflow", "pathPattern": ".github/workflows/**", "reason": "CI enforcement configuration", "requiresDecision": true }
  ]
}

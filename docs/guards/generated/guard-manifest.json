        "public-contract",
        "identity-security",
        "authentication",
        "authorization",
        "messaging"
      ],
      "stages": [
        "pre",
        "post",
        "ci"
      ],
      "enforcement": "advisory",
      "coverage": "none",
      "detectors": [],
      "limitations": "LayerGuard reports semantic symbol binding as notChecked. The new assembly detector checks direct assembly references only; reviewers must inspect fully qualified and aliased symbol uses where ownership matters.",
      "evidenceRequirement": "Human architecture review or a future per-symbol semantic detector with positive and negative fixtures."
    },
    {
      "formatVersion": 1,

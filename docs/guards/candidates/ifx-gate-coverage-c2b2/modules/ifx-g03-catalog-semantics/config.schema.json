{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g03-catalog-semantics/config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["enabledClaims", "policySha256", "catalogSha256"],
  "properties": {
    "enabledClaims": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": [
        { "const": "IFX.C2.G03_PROTOCOL_LIFECYCLE" },
        { "const": "IFX.C2.G03_FIELD_GOVERNANCE" },
        { "const": "IFX.C2.G03_LEGACY_SURFACE" },
        { "const": "IFX.C2.G03_CHANGE_CONTROL" }
      ], "additionalItems": false
    },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

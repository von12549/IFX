{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g03-docs-closeout/result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "findings", "coverage"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail", "error"] },
    "exitCategory": { "enum": ["success", "findings-blocking", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing"] },
    "message": { "type": "string" },
    "findings": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "subject", "evidenceKind", "detectorId", "severity"],
      "properties": {
        "ruleId": { "enum": ["G03-DOCUMENTATION", "G03-LEGACY-DEADLINE", "G03-CLOSEOUT-READINESS"] },
        "subject": { "type": "string", "minLength": 1 },
        "evidenceKind": { "enum": ["governance-document", "legacy-deadline", "closeout-readiness"] },
        "detectorId": { "const": "ifx-g03-docs-closeout" },
        "severity": { "const": "blocking" }
      }
    } },
    "coverage": { "type": "array", "minItems": 3, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["claimId", "matched", "minimum"],
      "properties": {
        "claimId": { "enum": ["IFX.C2.G03_DOCUMENTATION", "IFX.C2.G03_LEGACY_DEADLINE", "IFX.C2.G03_CLOSEOUT_READINESS"] },
        "matched": { "type": "integer", "minimum": 0 },
        "minimum": { "const": 1 }
      }
    } }
  }
}

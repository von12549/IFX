{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g03-source-reconciliation/config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["enabledClaims", "policySha256", "catalogSha256"],
  "properties": {
    "enabledClaims": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": [
        { "const": "IFX.C2.G03_SOURCE_INVENTORY" },
        { "const": "IFX.C2.G03_SOURCE_RECONCILIATION" },
        { "const": "IFX.C2.G03_FIELD_SOURCE" }
      ], "additionalItems": false
    },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

    "message":{"type":"string"},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["ruleId","subject","evidenceKind","detectorId","severity"],"properties":{"ruleId":{"enum":["G05-CONTRACT-CARRIER","G05-EVENT-CARRIER"]},"subject":{"type":"string","minLength":1},"evidenceKind":{"enum":["carrier-conformance","coverage"]},"detectorId":{"const":"ifx-g05-carriers"},"severity":{"const":"blocking"}}}},
    "coverage":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["claimId","matched","minimum"],"properties":{"claimId":{"enum":["IFX.C4.G05_CONTRACT_CARRIER","IFX.C4.G05_EVENT_CARRIER"]},"matched":{"type":"integer","minimum":0},"minimum":{"const":1}}}}
  }

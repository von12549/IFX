{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g03-governance-core/result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "findings", "coverage"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail", "error"] },
    "exitCategory": { "enum": ["success", "findings-blocking", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing"] },
    "message": { "type": "string" },
    "findings": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "subject", "evidenceKind", "detectorId", "severity"],
      "properties": {
        "ruleId": { "enum": ["G03-OWNERSHIP", "G03-PROVIDER-GRAPH", "G03-WAIVER-POLICY", "G03-PROJECTION"] },
        "subject": { "type": "string", "minLength": 1 },
        "evidenceKind": { "enum": ["catalog-governance", "governance-projection", "coverage"] },
        "detectorId": { "const": "ifx-g03-governance-core" },
        "severity": { "const": "blocking" }
      }
    } },
    "coverage": { "type": "array", "minItems": 4, "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["claimId", "matched", "minimum"],
      "properties": {
        "claimId": { "enum": ["IFX.C2.G03_OWNERSHIP", "IFX.C2.G03_PROVIDER_GRAPH", "IFX.C2.G03_WAIVER_POLICY", "IFX.C2.G03_PROJECTION"] },
        "matched": { "type": "integer", "minimum": 0 },
        "minimum": { "const": 1 }
      }
    } }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-g03-governance-core/config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["enabledClaims", "policySha256", "catalogSha256", "projectionSha256"],
  "properties": {
    "enabledClaims": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": [
        { "const": "IFX.C2.G03_OWNERSHIP" },
        { "const": "IFX.C2.G03_PROVIDER_GRAPH" },
        { "const": "IFX.C2.G03_WAIVER_POLICY" },
        { "const": "IFX.C2.G03_PROJECTION" }
      ],
      "additionalItems": false
    },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "catalogSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

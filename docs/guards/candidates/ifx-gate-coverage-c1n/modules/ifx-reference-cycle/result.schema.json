{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-reference-cycle/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "findings", "coverage"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail", "error"] },
    "exitCategory": { "enum": ["success", "findings-blocking", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing"] },
    "message": { "type": "string" },
    "findings": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["ruleId", "subject", "evidenceKind", "detectorId", "severity"],
      "properties": {
        "ruleId": { "enum": ["RING-REFERENCE", "CONTRACT-CYCLE"] },
        "subject": { "type": "string", "minLength": 1 },
        "evidenceKind": { "enum": ["project-reference-raw", "contracts-project-cycle-raw", "coverage"] },
        "detectorId": { "const": "ifx-reference-cycle" },
        "severity": { "const": "blocking" }
      }
    } },
    "coverage": { "type": "array", "minItems": 2, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["claimId", "matched", "minimum"],
      "properties": {
        "claimId": { "enum": ["IFX.C1.RING_REFERENCE_RAW", "IFX.C1.CONTRACT_CYCLE_RAW"] },
        "matched": { "type": "integer", "minimum": 0 },
        "minimum": { "const": 1 }
      }
    } }
  }
}

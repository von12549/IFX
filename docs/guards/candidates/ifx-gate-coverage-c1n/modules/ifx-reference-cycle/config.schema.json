{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/candidates/ifx-reference-cycle/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabledClaims", "policySha256"],
  "properties": {
    "enabledClaims": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": [
        { "const": "IFX.C1.RING_REFERENCE_RAW" },
        { "const": "IFX.C1.CONTRACT_CYCLE_RAW" }
      ],
      "additionalItems": false
    },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

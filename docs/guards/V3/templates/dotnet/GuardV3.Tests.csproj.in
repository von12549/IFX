<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>__TARGET_FRAMEWORK__</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>__PROJECT_NAMESPACE__</RootNamespace>
    <AssemblyName>__PROJECT_NAMESPACE__</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
__ARCHUNIT_PACKAGE_REFERENCE__
  </ItemGroup>
  <ItemGroup>
    <None Include="GeneratedInputs/profile.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GeneratedInputs/project-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GeneratedInputs/tech-stack.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GeneratedInputs/identity.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GeneratedInputs/rules/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "areas", "riskTriggers"],
  "properties": {
    "formatVersion": { "const": 1 },
    "areas": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "pathPattern", "layer", "owner", "similarImplementationRoot", "focusedCommands"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pathPattern": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "similarImplementationRoot": { "type": "string", "minLength": 1 },
          "focusedCommands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "riskTriggers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "pathPattern", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pathPattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

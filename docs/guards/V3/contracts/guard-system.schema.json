{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V3 guard system manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "packageId",
    "role",
    "engine",
    "stages",
    "manifests",
    "compatibility"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "enum": [
        "portable-engine",
        "overlay"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "status"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "canonical",
            "referenced",
            "forked-until-p7"
          ]
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bootstrap",
          "analysis",
          "pre",
          "post",
          "diff",
          "ci"
        ]
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "trustedComponents",
        "stages"
      ],
      "properties": {
        "commands": {
          "type": "string",
          "minLength": 1
        },
        "trustedComponents": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "entries"
      ],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "deprecationOutput",
            "internalPaths",
            "removal"
          ],
          "properties": {
            "period": {
              "type": "string",
              "minLength": 1
            },
            "deprecationOutput": {
              "type": "string",
              "minLength": 1
            },
            "internalPaths": {
              "type": "string",
              "minLength": 1
            },
            "removal": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "legacyPath",
              "kind",
              "replacement",
              "compatibility",
              "removeWhen",
              "phase"
            ],
            "properties": {
              "legacyPath": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "directory",
                  "public-command",
                  "internal-command",
                  "file"
                ]
              },
              "replacement": {
                "type": "string",
                "minLength": 1
              },
              "compatibility": {
                "enum": [
                  "deprecation-wrapper",
                  "none"
                ]
              },
              "removeWhen": {
                "type": "string",
                "minLength": 1
              },
              "phase": {
                "type": "string",
                "pattern": "^P([0-9]|1[01])(\\.[0-9]+)?$"
              }
            }
          }
        }
      }
    }
  }
}

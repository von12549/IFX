{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "profile", "projectMap", "techStack", "rulesDirectory", "viewsDirectory"],
  "properties": {
    "formatVersion": { "const": 1 },
    "profile": { "$ref": "#/definitions/repositoryPath" },
    "projectMap": { "$ref": "#/definitions/repositoryPath" },
    "techStack": { "$ref": "#/definitions/repositoryPath" },
    "rulesDirectory": { "$ref": "#/definitions/repositoryPath" },
    "viewsDirectory": { "$ref": "#/definitions/repositoryPath" }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*[?*])[^\\\\]+$"
    }
  }
}
